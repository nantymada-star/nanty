// Utilisé seulement pour un déploiement Cloudflare Workers (npx wrangler deploy).
// Cloudflare Pages ignore ce fichier et utilise le dossier functions/.
{
  "name": "madaprice",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/hapi-proxy/*"]
  }
}
