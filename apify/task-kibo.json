{
  "runMode": "PRODUCTION",
  "respectRobotsTxtFile": true,
  "startUrls": [
    {
      "url": "https://www.kibo.mg/tananarive/"
    }
  ],
  "linkSelector": "a[href]",
  "globs": [
    {
      "glob": "https://www.kibo.mg/tananarive/[0-9]*"
    }
  ],
  "excludes": [
    {
      "glob": "https://www.kibo.mg/tananarive/*{order,tag,search_query,back,controller,q}=*"
    },
    {
      "glob": "https://www.kibo.mg/tananarive/*.{jpg,png,css,js}"
    }
  ],
  "pageFunction": "// coller ici le contenu de apify/pageFunction.js",
  "injectJQuery": true,
  "maxRequestsPerCrawl": 3000,
  "maxConcurrency": 2,
  "proxyConfiguration": {
    "useApifyProxy": true
  }
}